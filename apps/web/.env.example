# ---------------------------------------------------------------------------
# Once Was Yours — web app environment
# Copy to .env.local for local dev. NEVER commit real secrets.
# (implementation plan §1.5 — new Supabase publishable/secret key convention)
# ---------------------------------------------------------------------------

# --- Public (safe to expose to the browser) --------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Show the Google/Apple sign-in buttons. Keep "false" until real OAuth apps are
# configured in the Supabase dashboard, so users don't hit dead-end buttons.
NEXT_PUBLIC_OAUTH_ENABLED=false

# --- Phase 11.5 PostHog product analytics (optional) -----------------------
# When NEXT_PUBLIC_POSTHOG_KEY is unset, event tracking still writes the local
# JSONL log but sends nothing to PostHog (no-op). Set the project API key to
# activate. Host defaults to https://eu.i.posthog.com.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# --- Monitoring (Sentry). DSN is public; token/org/project used for builds ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# --- Server-only secrets (never prefixed NEXT_PUBLIC, never in git) ---------
SUPABASE_SECRET_KEY=
STRIPE_SECRET_KEY=
OPENAI_API_KEY=
# --- Transactional email (provider-independent adapter — see docs/email.md) ---
# In-app notifications ALWAYS work; these only control EMAIL delivery. With no
# provider configured the app runs the silent "noop" provider (no email sent).
# Provider is auto-detected from credentials, or forced with OWY_EMAIL_PROVIDER:
#   auto (default) | resend | smtp | log | none
OWY_EMAIL_PROVIDER=
# Resend (HTTP API):
RESEND_API_KEY=
# SMTP (Zoho ZeptoMail / Zoho Mail / SES / any SMTP). Recommended for prod:
# ZeptoMail — SMTP_HOST=smtp.zeptomail.eu, SMTP_USER=emailapikey, token as SMTP_PASS.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# From-address for all transactional mail (default: "Once Was Yours <info@gestionatech.de>").
OWY_EMAIL_FROM=
SENTRY_AUTH_TOKEN=

# --- Phase 0 validation storage (JSONL fallback until Supabase is wired) ----
# Where waitlist + analytics events are written on the server.
OWY_DATA_DIR=./data
# Shared secret to read GET /api/stats?key=...  (use a long random value)
OWY_ADMIN_KEY=change-me-to-a-long-random-string

# --- Phase 4 AI Story Assistant (optional) ---------------------------------
# OpenAI API key. When unset, the story editor's AI polish buttons are hidden
# and only the user's own words are used. Never commit a real key.
OPENAI_API_KEY=
# Optional model override (defaults to gpt-4o-mini).
OWY_AI_MODEL=

# --- Phase 9 Stripe Connect (use sandbox keys in dev) ----------------------
# Server secret + publishable (use the test-mode keys in dev). Never commit real keys.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Webhook signing secret (whsec_...) from `stripe listen` / the dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
