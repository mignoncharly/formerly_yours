# ---------------------------------------------------------------------------
# Formerly Yours — Phase 0 (product validation) environment
# Copy to .env.local for local dev. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public base URL of the app (used for absolute links / OpenGraph).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Where the JSONL validation data (waitlist + events) is written on the server.
# Defaults to ./data if unset. On the VPS point this at a persistent volume.
FY_DATA_DIR=./data

# Simple shared secret to read the aggregated validation stats endpoint
# (GET /api/stats?key=...). Set to a long random value in production.
FY_ADMIN_KEY=change-me-to-a-long-random-string
