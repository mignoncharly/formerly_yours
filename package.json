{
  "name": "once-was-yours",
  "version": "0.0.0",
  "private": true,
  "description": "Once Was Yours — Sell the past. Fund what's next.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "web:dev": "pnpm --filter @owy/web dev",
    "web:build": "pnpm --filter @owy/web build",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff",
    "db:reset": "supabase db reset"
  },
  "devDependencies": {
    "pg": "^8.22.0",
    "rimraf": "^6.0.1",
    "turbo": "^2.3.3"
  }
}
